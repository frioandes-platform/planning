<mxfile><diagram name="Página-1"><mxGraphModel adaptiveColors="auto" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Fabric: región, residencia y datos personales" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1700" height="30" as="geometry"/></mxCell><mxCell id="z2" value="Región principal del tenant (por confirmar)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="420" height="580" as="geometry"/></mxCell><mxCell id="i3" value="Permisos y grupos" style="image;aspect=fixed;html=1;points=[];labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=10;image=img/lib/azure2/identity/Users.svg;labelWidth=280;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="40" height="40" as="geometry"/></mxCell><mxCell id="i4" value="Metadatos de reportes y mosaicos" style="image;aspect=fixed;html=1;points=[];labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=10;image=img/lib/azure2/analytics/Power_BI_Embedded.svg;labelWidth=280;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="40" height="40" as="geometry"/></mxCell><mxCell id="i5" value="Metadatos del gateway y credencial&lt;br&gt;cifrada de fabric_lector" style="image;aspect=fixed;html=1;points=[];labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=10;image=img/lib/azure2/networking/On_Premises_Data_Gateways.svg;labelWidth=280;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="40" height="40" as="geometry"/></mxCell><mxCell id="t6" value="Se revisa en Fabric (Ayuda, Acerca de, “Your data is stored in”) antes de comprar la capacidad.&lt;br&gt;&lt;br&gt;En Estados Unidos o México: nada que agregar.&lt;br&gt;&lt;br&gt;Fuera de la lista de la SIC: se registra como transmisión y ningún nombre de reporte, mosaico, filtro ni parámetro lleva datos de conductores o destinatarios." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="380" width="380" height="170" as="geometry"/></mxCell><mxCell id="z7" value="Estados Unidos · East US 2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="60" width="830" height="580" as="geometry"/></mxCell><mxCell id="z8" value="Fabric · fcfaprod · OneLake" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="100" width="380" height="520" as="geometry"/></mxCell><mxCell id="b9" value="Copia: vistas del libro operativo.&lt;br&gt;Único dato personal: la ubicación&lt;br&gt;del punto de entrega" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="530" y="140" width="340" height="70" as="geometry"/></mxCell><mxCell id="b10" value="Atajos: se leen en su lugar, no se copian.&lt;br&gt;&lt;br&gt;Posiciones de los camiones.&lt;br&gt;Fotos, comprobantes y clips de reclamos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=10;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="530" y="270" width="340" height="200" as="geometry"/></mxCell><mxCell id="b11" value="Resultados de la revisión de evidencias:&lt;br&gt;ruta, guía, fecha y resultado, sin imágenes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;fontSize=10;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="530" y="510" width="340" height="70" as="geometry"/></mxCell><mxCell id="z12" value="Fuentes en Azure" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1565C0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="100" width="370" height="520" as="geometry"/></mxCell><mxCell id="i13" value="Base transaccional. Nombres, teléfonos,&lt;br&gt;documentos y direcciones escritas&lt;br&gt;no entran a Fabric" style="image;aspect=fixed;html=1;points=[];labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=10;image=img/lib/azure2/databases/Azure_Database_MySQL_Server.svg;labelWidth=230;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="151" width="48" height="48" as="geometry"/></mxCell><mxCell id="i14" value="Tabla de análisis&lt;br&gt;con las posiciones" style="image;aspect=fixed;html=1;points=[];labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=10;image=img/lib/azure2/storage/Data_Lake_Storage_Gen1.svg;labelWidth=230;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="296" width="48" height="48" as="geometry"/></mxCell><mxCell id="i15" value="Archivo: documentos y video.&lt;br&gt;El resto del video, los PDF y los&lt;br&gt;históricos de temperatura no se leen" style="image;aspect=fixed;html=1;points=[];labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=10;image=img/lib/azure2/storage/Storage_Accounts.svg;labelWidth=230;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960" y="416" width="48" height="48" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#1565C0;strokeWidth=2;fontSize=10;fontColor=#1565C0;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="175" as="sourcePoint"/><mxPoint x="870" y="175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6A1B9A;strokeWidth=2;fontSize=10;fontColor=#6A1B9A;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="320" as="sourcePoint"/><mxPoint x="870" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6A1B9A;strokeWidth=2;fontSize=10;fontColor=#6A1B9A;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="440" as="sourcePoint"/><mxPoint x="870" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="z19" value="Estados Unidos · Central US" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="60" width="360" height="580" as="geometry"/></mxCell><mxCell id="i20" value="Evidencia cruda inmutable.&lt;br&gt;Fabric no la lee" style="image;aspect=fixed;html=1;points=[];labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontSize=10;image=img/lib/azure2/storage/Data_Lake_Storage_Gen1.svg;labelWidth=230;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1390" y="110" width="44" height="44" as="geometry"/></mxCell><mxCell id="z21" value="Recuperación si falla East US 2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#757575;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1380" y="220" width="320" height="400" as="geometry"/></mxCell><mxCell id="t22" value="1. Capacidad nueva en Central US, misma geografía.&lt;br&gt;&lt;br&gt;2. Espacios y elementos desde Git y las canalizaciones de implementación.&lt;br&gt;&lt;br&gt;3. Gateway en la red de recuperación (10.104.0.0/15) y Copy Job contra la base promovida.&lt;br&gt;&lt;br&gt;Sin interruptor de recuperación de OneLake: lo que guarda se reconstruye desde las fuentes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1395" y="280" width="290" height="220" as="geometry"/></mxCell><mxCell id="z23" value="Borrado a los cinco años y supresiones" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#616161;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="1690" height="100" as="geometry"/></mxCell><mxCell id="t24" value="Lo que se lee por atajo se borra en el origen, con las reglas de cada cuenta." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="700" width="520" height="56" as="geometry"/></mxCell><mxCell id="t25" value="Lo copiado recibe la anonimización de la base, porque cambia la marca de agua." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="610" y="700" width="520" height="56" as="geometry"/></mxCell><mxCell id="t26" value="Resultados y filas de telemetría de más de cinco años: cuaderno mensual de Fabric." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1170" y="700" width="520" height="56" as="geometry"/></mxCell><mxCell id="t27" value="Azul: lo único que se copia. Morado: lo que Fabric lee sin copiar. Todo queda en la geografía de Estados Unidos, en la lista de países con nivel adecuado de la SIC. OneLake replica sus datos en reposo dentro de la misma geografía. La revisión de imágenes solo marca fotos ilegibles o carga dañada; no identifica personas." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="785" width="1690" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>