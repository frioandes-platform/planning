<mxfile><diagram name="Página-1"><mxGraphModel adaptiveColors="auto" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Datos personales: por dónde entran, dónde viven, cuánto duran y quién los ve" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="z2" value="Titulares" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="240" height="640" as="geometry"/></mxCell><mxCell id="z3" value="Por dónde entran" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="240" height="640" as="geometry"/></mxCell><mxCell id="z4" value="Azure · East US 2 (Estados Unidos)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="700" height="640" as="geometry"/></mxCell><mxCell id="z5" value="Azure · Central US (Estados Unidos)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="70" width="260" height="640" as="geometry"/></mxCell><mxCell id="z6" value="Quién ve qué" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1620" y="70" width="340" height="640" as="