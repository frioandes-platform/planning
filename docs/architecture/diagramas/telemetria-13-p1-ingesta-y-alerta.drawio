rent="1"><mxGeometry x="1420" y="500" width="46" height="18" as="geometry"/></mxCell><mxCell id="e52" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=2;fontSize=10;fontColor=#C62828;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1388" y="358" as="sourcePoint"/><mxPoint x="1636" y="174" as="targetPoint"/><Array as="points"><mxPoint x="1530" y="358"/><mxPoint x="1530" y="174"/></Array></mxGeometry></mxCell><mxCell id="e53" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=2;fontSize=10;fontColor=#C62828;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1388" y="372" as="sourcePoint"/><mxPoint x="1636" y="314" as="targetPoint"/><Array as="points"><mxPoint x="1540" y="372"/><mxPoint x="1540" y="314"/></Array></mxGeometry></mxCell><mxCell id="e54" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#C62828;strokeWidth=2;fontSize=10;fontColor=#C62828;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1388" y="386" as="sourcePoint"/><mxPoint x="1636" y="454" as="targetPoint"/><Array as="points"><mxPoint x="1530" y="386"/><mxPoint x="1530" y="454"/></Array></mxGeometry></mxCell><mxCell id="b55" value="Volumen declarado (mensajes de 1 KB)&lt;br&gt;Normal: 7,2 mensajes por segundo, unos 486.000 al día&lt;br&gt;Campaña con 180 camiones: 10,2 por segundo, unos 682.000 al día" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=11;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="560" height="80" as="geometry"/></mxCell><mxCell id="b56" value="Presupuesto de la alerta: hasta 40 s desde la hora de la lectura del sensor&lt;br&gt;hasta que se ve en pantalla (5 + 10 + 10 + 5 + 10 s), con 20 s de margen dentro del minuto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=11;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="620" y="740" width="560" height="80" as="geometry"/></mxCell><mxCell id="b57" value="Destinatario según la hora de Colombia&lt;br&gt;04:00 a 22:00: torre de control (consola y Teams), copia a calidad&lt;br&gt;22:00 a 04:00: guardia de calidad (Teams, correo y SMS). Escala a los 5 y a los 15 minutos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=11;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1210" y="740" width="560" height="80" as="geometry"/></mxCell><mxCell id="t58" value="Azul: camino 1, cuartos fríos por la VPN y el Azure Firewall. Naranja: camino 2, camiones por internet. Verde: lecturas hacia el procesamiento y el mapa. Rojo: alertas. Gris punteado: configuración. Stream Analytics también escribe el historial (ver el diagrama del historial)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="840" width="1740" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>