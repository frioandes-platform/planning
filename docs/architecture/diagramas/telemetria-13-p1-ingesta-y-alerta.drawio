<mxfile><diagram name="Página-1"><mxGraphModel adaptiveColors="auto" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Telemetría: los dos caminos de ingesta y el camino de la alerta" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="z2" value="Ocho centros · camino 1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="300" height="320" as="geometry"/></mxCell><mxCell id="z3" value="Camiones · camino 2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="300" height="230" as="geometry"/></mxCell><mxCell id="z4" value="Hub · East US 2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="70" width="280" height="240" as="geometry"/></mxCell><mxCell id="z5" value="vnet-prod&lt;br&gt;snet-ingest" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="330" width="280" height="120" as="geometry"/></mxCell><mxCell id="z6" value="Central US" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="70" width="300" height="560" as="geometry"/></mxCell><mx