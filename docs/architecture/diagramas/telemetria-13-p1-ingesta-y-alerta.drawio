" y="262" width="220" height="76" as="geometry"/></mxCell><mxCell id="i13" value="120 camiones (180 en campaña)&lt;br&gt;temperatura cada 60 s&lt;br&gt;posición cada 30 s&lt;br&gt;guardan 18 h sin señal" style="html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.mobile;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;labelWidth=180;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="100" y="520" width="48" height="48" as="geometry"/></mxCell><mxCell id="i14" value="VPN Gateway" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;labelWidth=100;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="110" width="56" height="56" as="geometry"/></mxCell><mxCell id="i15" value="Azure Firewall&lt;br&gt;FW-204" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/networking/Firewalls.svg;labelWidth=76;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="56" height="56" as="geometry"/></mxCell><mxCell id="i16" value="Endpoints privados&lt;br&gt;de IoT Hub y DPS" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/networking/Private_Endpoint.svg;labelWidth=120;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="372" width="44" height="44" as="geometry"/></mxCell><mxCell id="i17" value="Internet" style="html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.cloud;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;labelWidth=80;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="500" width="70" height="70" as="geometry"/></mxCell><mxCell id="i18" value="DPS: alta automática&lt;br&gt;con certifi