<mxfile><diagram name="Página-1"><mxGraphModel adaptiveColors="auto" grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z1" value="Producción · East US 2 (vnet-prod 10.101.0.0/21)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#616161;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1010" height="820" as="geometry"/></mxCell><mxCell id="z2" value="Continuidad · Central US, región pareja (vnet-prod 10.104.0.0/15)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="30" width="420" height="820" as="geometry"/></mxCell><mxCell id="z3" value="Front · Azure Container Apps&lt;br&gt;snet-app-torre y snet-app-portal" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="460" height="210" as="geometry"/></mxCell><mxCell id="z4" value="Servicios de negocio&lt;br&gt;(dentro de los mismos entornos de Container Apps)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="460" height="190" as="geometry"/></mxCell><mxCell id="z5" value="Datos · snet-data y snet-data-pe" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="450" height="240" as="geometry"/></mxCell><mxCell id="z6" value="Seguridad · toda la plataforma" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="340" width="450" height="230" as="geometry"/></mxCell><mxCell id="z7" value="Clientes y usuarios" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="950" height="190" as="geometry"/></mxCell><mxCell id="i8" value="450 usuarios internos&lt;br&gt;(despacho, vía Entra ID)" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/identity/Users.svg;labelWidth=150;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="100" y="650" width="56" height="56" as="geometry"/></mxCell><mxCell id="i9" value="~2.000 clientes corporativos&lt;br&gt;(portal, por internet)" style="html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.users;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;labelWidth=160;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="650" width="56" height="56" as="geometry"/></mxCell><mxCell id="i10" value="Consola de despacho (torre)&lt;br&gt;Container Apps, snet-app-torre" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/other/Container_App_Environments.svg;labelWidth=190;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="100" y="130" width="64" height="64" as="geometry"/></mxCell><mxCell id="i11" value="Servicios del portal&lt;br&gt;Container Apps, snet-app-portal" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/other/Container_App_Environments.svg;labelWidth=190;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="64" height="64" as="geometry"/></mxCell><mxCell id="t12" value="Guías · inventario · asignación de muelle y ruta ·&lt;br&gt;facturación corporativa.&lt;br&gt;&lt;br&gt;Los cuatro servicios corren en los mismos entornos&lt;br&gt;de Container Apps de arriba; aquí se muestran&lt;br&gt;aparte solo para separarlos del front." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="345" width="410" height="150" as="geometry"/></mxCell><mxCell id="i13" value="MySQL Flexible Server&lt;br&gt;HA zonal, 2 réplicas, snet-data" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/databases/Azure_Database_MySQL_Server.svg;labelWidth=190;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="610" y="130" width="64" height="64" as="geometry"/></mxCell><mxCell id="i14" value="Azure Managed Redis&lt;br&gt;snet-data-pe" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/databases/Azure_Managed_Redis.svg;labelWidth=150;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="850" y="130" width="56" height="56" as="geometry"/></mxCell><mxCell id="i15" value="Key Vault&lt;br&gt;secretos y certificados" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/security/Key_Vaults.svg;labelWidth=160;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="610" y="390" width="56" height="56" as="geometry"/></mxCell><mxCell id="i16" value="Microsoft Entra ID&lt;br&gt;MFA para administradores" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/identity/Users.svg;labelWidth=170;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="850" y="390" width="56" height="56" as="geometry"/></mxCell><mxCell id="i17" value="Réplica geo-redundante&lt;br&gt;RPO 15 min" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/databases/Azure_Database_MySQL_Server.svg;labelWidth=180;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1140" y="130" width="64" height="64" as="geometry"/></mxCell><mxCell id="i18" value="Entornos en espera&lt;br&gt;failover manual, RTO 4h" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=11;image=img/lib/azure2/other/Container_App_Environments.svg;labelWidth=180;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1140" y="340" width="64" height="64" as="geometry"/></mxCell><mxCell id="t19" value="El failover no es automático: el runbook de continuidad&lt;br&gt;promueve la réplica de Central US a primaria y activa&lt;br&gt;los entornos de Container Apps en espera.&lt;br&gt;&lt;br&gt;El RPO de 15 min lo cumple la replicación geo-redundante&lt;br&gt;de MySQL Flexible Server. El RTO de 4h es el tiempo del&lt;br&gt;runbook, no una conmutación automática.&lt;br&gt;&lt;br&gt;La caché no se replica: al activar la región de respaldo&lt;br&gt;arranca vacía y se llena con el primer tráfico." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1125" y="480" width="360" height="300" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#2E7D32;strokeWidth=2;fontSize=10;fontColor=#2E7D32;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="164" y="162" as="sourcePoint"/><mxPoint x="610" y="230" as="targetPoint"/><Array as="points"><mxPoint x="270" y="162"/><mxPoint x="270" y="230"/></Array></mxGeometry></mxCell><mxC