t="12.5" as="geometry"/></mxCell><mxCell id="b41" value="Copy Job, Python y Spark 0,9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#757575;fontSize=9;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1000" y="450.0" width="130" height="22.5" as="geometry"/></mxCell><mxCell id="b42" value="Reservas: reportes, IA, SQL 2,6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#757575;fontSize=9;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1000" y="385.0" width="130" height="65.0" as="geometry"/></mxCell><mxCell id="t43" value="Mes normal: 8,2" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1000" y="594" width="130" height="20" as="geometry"/></mxCell><mxCell id="b44" value="Gateway 3,2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#757575;fontSize=9;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1150" y="510.0" width="130" height="80.0" as="geometry"/></mxCell><mxCell id="b45" value="Eventstream 1,0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#757575;fontSize=9;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1150" y="485.0" width="130" height="25.0" as="geometry"/></mxCell><mxCell id="b46" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#757575;fontSize=9;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1150" y="467.5" width="130" height="17.5" as="geometry"/></mxCell><mxCell id="b47" value="Copy Job, Python y Spark 1,0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#757575;fontSize=9;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1150" y="442.5" width="130" height="25.0" as="geometry"/></mxCell><mxCell id="b48" value="Reservas: reportes, IA, SQL 4,85" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#757575;fontSize=9;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1150" y="321.25" width="130" height="121.24999999999999" as="geometry"/></mxCell><mxCell id="t49" value="Campaña: 10,7" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1150" y="594" width="130" height="20" as="geometry"/></mxCell><mxCell id="t50" value="Bloques, de abajo arriba: gateway, Eventstream, Activator, Copy Job, Python y Spark nocturno, reservas para reportes, funciones de IA y consultas SQL.&lt;br&gt;&lt;br&gt;Arranque: F16 en mes normal y en campaña.&lt;br&gt;&lt;br&gt;Si el primer mes queda por debajo del 40 %, F8 fuera de campaña y F16 una semana antes de cada campaña, con el runbook.&lt;br&gt;&lt;br&gt;fcfanoprod: F4, de lunes a viernes de 07:00 a 19:00." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1400" y="120" width="225" height="470" as="geometry"/></mxCell><mxCell id="t51" value="Azure Monitor no tiene métricas de plataforma para Fabric: la falla de Fabric se ve por la antigüedad que publican la torre y el portal, por los eventos de trabajos y por los registros de los modelos. Casi toda la carga es de segundo plano y se suaviza en 24 horas, por eso no se cambia de tamaño entre el día y la noche." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#212121;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="635" width="1610" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>